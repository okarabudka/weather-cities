{
    "name": "okarabudka/weather-cities",
    "description": "Cities from a data file, current weather from OpenWeatherMap, sorted by temperature spread. Plain PHP, no framework.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "WeatherCities\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeatherCities\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "find bin public src templates tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "stan": "phpstan analyse --no-progress --memory-limit=512M",
        "test": "phpunit",
        "check": ["@lint", "@stan", "@test"]
    }
}
