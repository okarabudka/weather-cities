# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# OpenWeatherMap API key (free tier is enough): https://home.openweathermap.org/api_keys
OWM_API_KEY=

# Seconds a weather response stays in the file cache.
CACHE_TTL=600
# Relative paths are resolved from the project root.
CACHE_DIR=var/cache
CITIES_FILE=data/cities.dat

# Host port for nginx.
HTTP_PORT=8080
